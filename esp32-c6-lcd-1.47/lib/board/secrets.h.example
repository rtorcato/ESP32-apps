// Copy to secrets.h (gitignored) and fill in. Shared by every app on this board.
//
// These values are compiled into the firmware binary, so a dumped flash gives
// them up in plaintext -- gitignoring this file protects the repo, not the
// device. Prefer credentials for an isolated IoT VLAN that you can rotate
// freely. See ../../../SECURITY.md.
#pragma once

#define WIFI_SSID "your-iot-ssid"
#define WIFI_PASS "your-password"
